{
  "name": "badminton-score",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA badminton scoreboard controlled by a Bluetooth camera remote",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8080",
    "test:rules": "firebase emulators:exec --only firestore --project demo-badminton \"node --test tests/rules/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-badminton"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "13.0.0",
    "firebase-tools": "^15.34.1",
    "qrcode-generator": "^2.0.4"
  }
}
