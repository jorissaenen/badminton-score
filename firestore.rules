rules_version = '2';

// Who may read and write what. Tested in tests/rules/ against the emulator (npm run test:rules).
// Publish after every change: Firebase console → Firestore Database → Rules (see
// docs/firebase-setup.md, step 4b).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A person with an account (Google or e-mail). Screens on /link sign in anonymously: they only
    // get keys and show what a club linked them to, and never create clubs, join or write profiles.
    function isPerson() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The signed-in user's role in a club ('' when not a member), and whether they may keep score
    // there (score keepers, admins, owners): they link screens to the club's events.
    function roleIn(clubId) {
      let path = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      return signedIn() && exists(path) ? get(path).data.role : '';
    }

    function canKeepIn(clubId) {
      return roleIn(clubId) in ['owner', 'admin', 'keeper'];
    }

    // Changes only these fields (and maybe not all of them).
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- users ----------

    // Own profile (name, photo; no e-mail address), and the list of clubs the user belongs to.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid) && isPerson() && (request.resource.data.get('photo', null) == null
        || (request.resource.data.photo is string && request.resource.data.photo.size() <= 100000
          && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')));

      match /clubs/{clubId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && isPerson();
      }

      // Watches linked to this account (written by the server when a watch is linked). Deleting
      // one unlinks that watch.
      match /watches/{watchId} {
        allow read, delete: if isMe(uid);
      }

      // Devices that get reminders: a push token per app installation (written by the app,
      // read by the reminder function, which bypasses these rules).
      match /devices/{deviceId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && isPerson();
      }
    }

    // ---------- watches ----------

    // A watch that isn't linked yet shows a key (written by the server: watchLinks/{key}). Someone
    // signed in with an account looks it up and confirms it: the watch then belongs to them.
    match /watchLinks/{key} {
      allow get: if isPerson();
      allow update: if isPerson() && resource.data.uid == null && resource.data.expiresAt > request.time
        && onlyChanges(['uid', 'userName', 'confirmedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.confirmedAt == request.time
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 60;
    }

    // ---------- screens (displays) ----------

    // A screen opens /link and signs in anonymously. Every 60 seconds it shows a new key, stored
    // here as displayCodes/{key} → its uid. Anyone signed in may look up one key (not list them),
    // as phones do after scanning the QR code or typing the key.
    match /displayCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 6
        && request.resource.data.keys().hasOnly(['display', 'expiresAt'])
        && request.resource.data.display == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(2, 'm');
      allow delete: if signedIn() && resource.data.display == request.auth.uid;
    }

    // What a screen shows: { clubId, eventId, mode: 'court' | 'overview', court, announce,
    // linkedBy, code }. A score keeper, admin or owner links it with a key that is still valid
    // (up to 2 minutes after it was shown), and then changes it or unlinks it. The screen reads
    // its own entry and only writes when it was last seen.
    match /displays/{displayId} {
      function codePath(code) {
        return /databases/$(database)/documents/displayCodes/$(code);
      }

      function validKey(d) {
        return d.code is string && d.code.size() == 6 && exists(codePath(d.code))
          && get(codePath(d.code)).data.display == displayId
          && get(codePath(d.code)).data.expiresAt + duration.value(2, 'm') > request.time;
      }

      function validLink(d) {
        return d.clubId is string && d.eventId is string && d.mode in ['court', 'overview']
          && (d.mode == 'overview' || (d.court is int && d.court >= 1 && d.court <= 40))
          && d.announce is bool && d.linkedBy == request.auth.uid;
      }

      allow get: if isMe(displayId)
        || (resource == null || canKeepIn(resource.data.clubId));
      allow list: if canKeepIn(resource.data.clubId);
      // Linking (or moving to another club or event) needs a valid key; changing what a linked
      // screen shows, by someone of the same club, doesn't.
      allow create: if canKeepIn(request.resource.data.clubId) && validLink(request.resource.data) && validKey(request.resource.data);
      allow update: if (canKeepIn(request.resource.data.clubId) && validLink(request.resource.data)
          && (validKey(request.resource.data)
            || (resource.data.get('clubId', null) == request.resource.data.clubId && canKeepIn(resource.data.clubId))))
        || (isMe(displayId) && onlyChanges(['lastSeen']));
      allow delete: if isMe(displayId) || canKeepIn(resource.data.clubId);
    }

    // ---------- clubs ----------

    match /clubs/{clubId} {
      function clubPath() {
        return /databases/$(database)/documents/clubs/$(clubId);
      }

      function memberPath(uid) {
        return /databases/$(database)/documents/clubs/$(clubId)/members/$(uid);
      }

      // The signed-in user's role in this club, or '' when not a member.
      function myRole() {
        return signedIn() && exists(memberPath(request.auth.uid))
          ? get(memberPath(request.auth.uid)).data.role : '';
      }

      function rank(role) {
        return role == 'owner' ? 4 : role == 'admin' ? 3 : role == 'keeper' ? 2 : role == 'member' ? 1 : 0;
      }

      function isMember() { return rank(myRole()) >= 1; }

      // A screen linked to this club (signed in anonymously, see /displays below): it reads the
      // club, its events and their matches, nothing else.
      function isLinkedDisplay() {
        let path = /databases/$(database)/documents/displays/$(request.auth.uid);
        return signedIn() && exists(path) && get(path).data.get('clubId', null) == clubId;
      }
      function isKeeper() { return rank(myRole()) >= 2; }
      function isAdmin() { return rank(myRole()) >= 3; }
      function isOwner() { return myRole() == 'owner'; }

      function validClub(d) {
        return d.keys().hasAll(['name', 'createdBy', 'schemaVersion'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.schemaVersion is int
          && d.get('place', '') is string && d.get('place', '').size() <= 80
          && d.get('placeAddress', '') is string && d.get('placeAddress', '').size() <= 160
          && d.get('placeNote', '') is string && d.get('placeNote', '').size() <= 280;
      }

      // Read by members. Created by anyone signed in, who becomes its owner in the same write
      // (see members). Changed by admins; the creator never changes. Deleted by owners.
      allow read: if isMember() || isLinkedDisplay();
      allow create: if isPerson() && request.resource.data.createdBy == request.auth.uid
        && validClub(request.resource.data);
      allow update: if isAdmin() && validClub(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isOwner();

      // ---------- members: one document per signed-in member, id = their uid ----------

      match /members/{uid} {
        // The photo: from Google (https) or chosen in the app (a small JPEG as a data: URL).
        function validMember(d) {
          return d.keys().hasAll(['role', 'name']) && rank(d.role) >= 1
            && d.name is string && d.name.size() <= 60
            && (d.get('photoURL', null) == null || (d.photoURL is string && d.photoURL.size() <= 100000
              && d.photoURL.matches('^(https://|data:image/jpeg;base64,).*')));
        }

        function invitePath(token) {
          return /databases/$(database)/documents/clubs/$(clubId)/invites/$(token);
        }

        // Joining with an invite that hasn't expired, with exactly the invite's role.
        function joinsWithInvite(d) {
          return d.keys().hasAll(['invite']) && exists(invitePath(d.invite))
            && get(invitePath(d.invite)).data.expiresAt > request.time
            && get(invitePath(d.invite)).data.role == d.role;
        }

        // The club's creator, as owner, in the same write that creates the club.
        function createsOwnClub(d) {
          return d.role == 'owner' && !exists(clubPath()) && getAfter(clubPath()).data.createdBy == uid;
        }

        allow read: if isMember();

        allow create: if isMe(uid) && isPerson() && validMember(request.resource.data)
          && (createsOwnClub(request.resource.data) || joinsWithInvite(request.resource.data));

        // Everyone updates their own name and photo. Admins change roles of non-owners, up to
        // admin; only owners make or unmake owners. Nobody changes their own role (an owner hands
        // over by making someone else owner first, who can then change the old owner's role).
        allow update: if validMember(request.resource.data) && (
          (isMe(uid) && onlyChanges(['name', 'photoURL']))
          || (!isMe(uid) && isOwner())
          || (!isMe(uid) && isAdmin() && resource.data.role != 'owner'
              && request.resource.data.role != 'owner' && onlyChanges(['role']))
        );

        // Leaving (anyone but an owner), or removal: admins remove non-owners, owners anyone else.
        // After deleting the club, its owner clears out the rest, their own entry last.
        allow delete: if (isMe(uid) && resource.data.role != 'owner')
          || (isMe(uid) && !exists(clubPath()))
          || (!isMe(uid) && isOwner())
          || (!isMe(uid) && isAdmin() && resource.data.role != 'owner');
      }

      // ---------- invites: id = a long random token, shared as a link or QR code ----------

      match /invites/{token} {
        function validInvite(d) {
          return d.keys().hasAll(['role', 'expiresAt', 'createdBy', 'clubName'])
            && d.role in ['admin', 'keeper', 'member'] && d.expiresAt is timestamp
            && d.expiresAt > request.time && d.expiresAt < request.time + duration.value(31, 'd')
            && d.createdBy == request.auth.uid && token.size() >= 20;
        }

        // Anyone signed in who has the link may read that one invite (to see the club's name
        // and join). Listing invites is for admins only, so tokens can't be collected.
        allow get: if isPerson();
        allow list: if isAdmin();
        allow create: if isAdmin() && validInvite(request.resource.data);
        allow delete: if isAdmin();
      }

      // ---------- seasons: periods for rankings and statistics ----------

      match /seasons/{seasonId} {
        function validSeason(d) {
          return d.keys().hasAll(['name', 'start', 'end']) && d.name is string
            && d.name.size() > 0 && d.name.size() <= 60
            && d.start is string && d.end is string && d.start <= d.end;
        }

        allow read: if isMember();
        allow create, update: if isAdmin() && validSeason(request.resource.data);
        allow delete: if isAdmin();
      }

      // ---------- players: everyone who plays, with or without an account; kept across seasons ----------

      match /players/{playerId} {
        function validPlayer(d) {
          return d.keys().hasAll(['name']) && d.name is string && d.name.size() > 0
            && d.name.size() <= 40;
        }

        allow read: if isMember();
        // Admins add and edit anyone, including guests (no account). A member adds or edits
        // their own player, or claims a guest player (one without an account) as theirs.
        allow create: if validPlayer(request.resource.data) && (isAdmin()
          || (isMember() && request.resource.data.get('uid', null) == request.auth.uid));
        allow update: if validPlayer(request.resource.data) && (isAdmin()
          || (isMember() && resource.data.get('uid', null) == request.auth.uid
              && request.resource.data.get('uid', null) == request.auth.uid)
          || (isMember() && resource.data.get('uid', null) == null
              && request.resource.data.get('uid', null) == request.auth.uid
              && onlyChanges(['uid', 'claimedAt'])));
        allow delete: if isAdmin();
      }

      // ---------- events: training evenings and tournaments ----------

      // A recurring series ("every Tuesday 20:00–21:30"); its dates are separate events.
      match /series/{seriesId} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      match /events/{eventId} {
        function validEvent(d) {
          return d.keys().hasAll(['type', 'date', 'start', 'end', 'startsAt', 'status'])
            && d.type in ['training', 'random', 'weighted', 'knockout']
            && d.status in ['planned', 'cancelled']
            && d.date is string && d.date.size() == 10
            && d.start is string && d.end is string && d.startsAt is timestamp
            && d.get('location', '') is string && d.get('location', '').size() <= 80
            && d.get('address', '') is string && d.get('address', '').size() <= 160
            && d.get('note', '') is string && d.get('note', '').size() <= 280
            && d.get('pinned', '') is string && d.get('pinned', '').size() <= 280;
        }

        allow read: if isMember() || isLinkedDisplay();
        allow create, update: if isAdmin() && validEvent(request.resource.data);
        allow delete: if isAdmin();

        // Going or not going, per player (id = playerId), with an optional note (an apology).
        // Members answer for their own player; admins for anyone, e.g. players without an account.
        match /registrations/{playerId} {
          function playerPath() {
            return /databases/$(database)/documents/clubs/$(clubId)/players/$(playerId);
          }

          function isMyPlayer() {
            return exists(playerPath()) && get(playerPath()).data.get('uid', null) == request.auth.uid;
          }

          function validRegistration(d) {
            return d.keys().hasAll(['status', 'by']) && d.status in ['going', 'not going']
              && d.by == request.auth.uid
              && d.get('note', '') is string && d.get('note', '').size() <= 140;
          }

          allow read: if isMember();
          // Admins answer for anyone; score keepers mark who's here during an event (the app
          // offers that only while it's on).
          allow create, update: if validRegistration(request.resource.data)
            && (isKeeper() || (isMember() && isMyPlayer()));
          allow delete: if isKeeper() || (isMember() && isMyPlayer());
        }
      }

      // ---------- matches: scored during an event, with the players on each side ----------

      // A member starts a match of an event and keeps its score (keeper = them). The keeper, or
      // an admin, updates it while it's played; the event, sport and players stay. An admin
      // removes a match; the keeper removes their own before it's finished.
      match /matches/{matchId} {
        function eventPath(eventId) {
          return /databases/$(database)/documents/clubs/$(clubId)/events/$(eventId);
        }

        function validSide(side) {
          return side is list && side.size() >= 1 && side.size() <= 2;
        }

        function validMatch(d) {
          return d.keys().hasAll(['eventId', 'sport', 'rules', 'home', 'away', 'state', 'status', 'keeper', 'schemaVersion'])
            && d.eventId is string && exists(eventPath(d.eventId))
            && d.sport is string && d.rules is map && d.state is map
            && validSide(d.home) && validSide(d.away)
            && d.status in ['live', 'finished', 'stopped']
            && d.keeper is string
            && (d.get('court', null) == null || (d.court is int && d.court >= 1 && d.court <= 40));
        }

        allow read: if isMember() || isLinkedDisplay();
        allow create: if isMember() && validMatch(request.resource.data)
          && request.resource.data.keeper == request.auth.uid
          && request.resource.data.status == 'live';
        // Several members can keep the score of one match. Every change is the next version of
        // the score, signed by whoever made it, so of two presses on the same score only the first
        // counts. After a point the score is frozen for 5 seconds: another point is refused, an
        // undo (or the next game, or stopping) is not, and ends the freeze.
        function scoreChange(old, d) {
          return d.version == old.get('version', 0) + 1
            && d.lastBy == request.auth.uid
            && d.get('lastByName', '') is string && d.get('lastByName', '').size() <= 60
            && ((d.lastAction in ['point0', 'point1'] && d.lastPointAt == request.time
                  && (old.get('lastPointAt', null) == null || request.time > old.lastPointAt + duration.value(5, 's')))
              || (d.lastAction in ['undo', 'next', 'stop'] && d.lastPointAt == null));
        }

        allow update: if isMember() && validMatch(request.resource.data)
          && scoreChange(resource.data, request.resource.data)
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.sport == resource.data.sport
          && request.resource.data.home == resource.data.home
          && request.resource.data.away == resource.data.away
          && request.resource.data.keeper == resource.data.keeper;
        allow delete: if isAdmin()
          || (isMember() && resource.data.keeper == request.auth.uid && resource.data.status != 'finished');
      }
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
