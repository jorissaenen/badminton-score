rules_version = '2';

// Security rules for Firestore (same rules for badminton-dev and badminton-prod).
// Publish: Firebase console → Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile: only they can read or write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else stays locked until the matching feature arrives.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
